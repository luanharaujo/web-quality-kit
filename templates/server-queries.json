    {"route": "GET /items"},
    {"route": "GET /items/:id/comments", "path": "/items/1/comments"}
  ],
  "exempt": {
    "GET /health": "no list"
  },
  "migrations": "api/migrations",
  "exempt_tables": {},
  "baseline": {"routes": [], "scans": []}
}
