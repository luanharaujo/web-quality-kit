{
  "mode": "absolute",
  "methods": [
    "whatsapp_code"
  ],
  "identifier": "phone",
  "source": [
    "api/src"
  ],
  "turnstile": {
    "hostname": "example.org"
  },
  "server": {
    "start": "cd api && npx wrangler dev --local --ip 127.0.0.1 --port {port} --var TURNSTILE_SECRET:{turnstile_secret} --var TURNSTILE_VERIFY_URL:{verify_url}",
    "url": "http://127.0.0.1:{port}",
    "ready": "/health",
    "timeout": 120
  },
  "seed": "bash api/scripts/seed_auth.sh",
  "routes": [
    {
      "route": "POST /login/start",
      "kind": "login",
      "handler": "api/src/login.ts:start",
      "turnstile_action": "login",
      "body": {
        "phone": "{id}",
        "cf-turnstile-response": "{token}"
      },
      "known": "5561900000001",
      "unknown": "5561900000002"
    }
  ],
  "exceptions": []
}
