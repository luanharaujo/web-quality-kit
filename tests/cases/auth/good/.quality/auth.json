{
  "mode": "absolute",
  "methods": ["whatsapp_code"],
  "identifier": "phone",
  "source": ["src"],
  "turnstile": {"hostname": "localhost"},
  "server": {
    "start": "node ../harness.mjs . {port}",
    "url": "http://127.0.0.1:{port}",
    "ready": "/",
    "timeout": 30
  },
  "routes": [
    {"route": "POST /login/start", "kind": "login", "handler": "src/worker.js:start",
     "body": {"phone": "{id}", "token": "{token}"}, "known": "5561900000001", "unknown": "5561900000002"},
    {"route": "POST /signup", "kind": "signup", "handler": "src/worker.js:signup",
     "body": {"phone": "{id}", "token": "{token}"}, "known": "5561900000001", "unknown": "5561900000002"}
  ]
}
