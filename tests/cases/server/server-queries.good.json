{
  "mode": "absolute",
  "counter": "templates/server/d1_queries.ts",
  "server": {
    "start": "node tests/cases/server/server.mjs good {tmp}/db.sqlite {port}",
    "url": "http://127.0.0.1:{port}",
    "ready": "/health"
  },
  "seed": "node tests/cases/server/seed.mjs {tmp}/db.sqlite tests/cases/server/migrations_good {n}",
  "routes_command": "printf 'GET /health\\nGET /orders\\nGET /customers\\n'",
  "routes": [
    {
      "route": "GET /orders"
    },
    {
      "route": "GET /customers"
    }
  ],
  "exempt": {
    "GET /health": "no list, no database"
  },
  "migrations": "tests/cases/server/migrations_good",
  "source": [
    "tests/cases/server/handlers_good.mjs",
    "tests/cases/server/external_good.mjs"
  ],
  "exempt_tables": {
    "plans": "a handful of fixed rows"
  },
  "fetch_timeout": {
    "max_ms": 10000,
    "internal_hosts": [
      "own.example.org"
    ]
  }
}
